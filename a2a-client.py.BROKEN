import asyncio
from a2a.client import Client

async def run_client():
    # Initialize the client targeting the agent's exposed interface
    client = Client("http://localhost:8000/a2a")
    
    print("Initiating A2A task delegation...")
    
    # Construct and dispatch the initial user message to the remote agent
    response = await client.send_message(
        content="Analyze the economic impact of open standard protocols.", #
        role="user" #
    )
    
    # Retrieve the unique Task ID generated by the remote server
    task_id = response.task.id #[cite: 1]
    print(f"Task successfully registered on remote server. ID: {task_id}") #[cite: 1]
    
    # Poll the server until the task state machine reaches an immutable terminal state
    while True:
        task_status = await client.get_task(task_id) #[cite: 1]
        current_state = task_status.state #[cite: 1]
        
        print(f"Current Task State: {current_state}") #[cite: 1]
        
        # Terminate the polling loop if the state is COMPLETED, FAILED, CANCELED, or REJECTED
        if current_state in ["completed", "failed", "canceled", "rejected"]: #[cite: 1]
            break
            
        # Implement backoff to prevent overwhelming the server
        await asyncio.sleep(1.0) #[cite: 1]
    
    # Upon completion, extract and parse the generated artifacts
    if task_status.state == "completed": #[cite: 1]
        print("\nTask execution successful. Retrieving artifacts:") #[cite: 1]
        for artifact in task_status.artifacts: #[cite: 1]
            for part in artifact.parts: #[cite: 1]
                print(f"Output: {part.text}") #[cite: 1]

if __name__ == "__main__":
    asyncio.run(run_client()) #[cite: 1]
